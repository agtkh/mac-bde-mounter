    "NSRemovableVolumesUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac BDE Mounter requires access to removable volumes to detect, unlock, and mount BitLocker®-encrypted external disks."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac BDE Mounter は、BitLocker® で暗号化された外付けディスクを検知・ロック解除・マウントするためにリムーバブルボリュームへのアクセスを必要とします。"
          }
        }
      }
    },
    "NSSystemAdministrationUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac BDE Mounter requires administrator privileges to manage the background disk mounting service."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac BDE Mounter は、バックグラウンドのディスクマウントサービスを管理するために管理者権限を必要とします。"
          }
        }
      }
    }
  },
  "version" : "1.0"
