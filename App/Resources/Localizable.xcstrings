    "oss.dislocker.purpose" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "BitLocker® encrypted partition decryption engine, providing access to NTFS/FAT/exFAT volumes via FUSE." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "BitLocker® 暗号化パーティションの復号エンジン。FUSE を介して NTFS/FAT/exFAT ボリュームへのアクセスを提供します。" } }
      }
    },
    "oss.fuset.purpose" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "User-space NFSv4 filesystem driver bridge enabling FUSE without kernel extensions." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "カーネル拡張（KEXT）不要で FUSE を実現するユーザースペース NFSv4 ファイルシステムブリッジ。" } }
      }
    },
    "oss.mbedtls.purpose" : {
      "localizations" : {
