    "uninstaller.confirm.action" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Run Uninstaller" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アンインストールを実行" } }
      }
    },
    "uninstaller.confirm.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This will completely remove Mac BDE Mounter and all associated components from your system:\n\n• Safely unmount active BitLocker® virtual volumes\n• Background privileged helper daemon (/Library/PrivilegedHelperTools/...)\n• LaunchDaemon service definitions (/Library/LaunchDaemons/...)\n• FUSE-T and support libraries (/Library/Application Support/MacBDEMounter)\n• Temporary mount points and working logs (/tmp/blm-*, /private/tmp/dislocker_*)\n• User preferences, caches, and application state\n• Full Disk Access permissions (TCC settings reset)\n• Application bundle (/Applications/MacBDEMounter.app)\n\nAdministrator authorization (Touch ID or password) is required to proceed. Do you wish to continue?" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Mac BDE Mounter とその関連コンポーネントをシステムから完全に削除します：\n\n• マウント中の BitLocker® 仮想ボリュームの安全な解除\n• バックグラウンド特権ヘルパーデーモン (/Library/PrivilegedHelperTools/...)\n• LaunchDaemon サービス設定 (/Library/LaunchDaemons/...)\n• FUSE-T および依存ライブラリ (/Library/Application Support/MacBDEMounter)\n• 一時マウントポイントおよび作業ログ (/tmp/blm-*, /private/tmp/dislocker_*)\n• ユーザー環境設定、キャッシュ、保存された状態\n• フルディスクアクセス権限 (TCC 設定のリセット)\n• アプリケーション本体 (/Applications/MacBDEMounter.app)\n\n続行するには管理者権限（Touch ID またはパスワード）が必要です。アンインストールを実行しますか？" } }
      }
    },
    "uninstaller.confirm.cancel" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "キャンセル" } }
